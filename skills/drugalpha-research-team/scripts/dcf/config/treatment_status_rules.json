{
  "version": "1.1",
  "defaultRuleId": "T0",
  "diseaseSpecificSeverityRule": {
    "ruleId": "T1",
    "label": "非肿瘤严重度限定（疾病特异检索）",
    "fallbackRatio": 0.3,
    "description": "中重度、重度、重症、活动性等非肿瘤口径不使用统一固定比例；优先联网检索具体疾病、地区和严重度定义，缺少有效结果时按30%保守占位并提示复核。",
    "keywords": ["轻中度", "轻度至中度", "中重度", "中度至重度", "重度", "重症", "中高危", "活动性", "需要积极治疗", "系统治疗候选", "适合系统治疗"]
  },
  "rules": [
    {
      "ruleId": "T4",
      "priority": 50,
      "label": "四线及以上/末线治疗",
      "ratio": 0.2,
      "description": "仅在适应症明确写明四线及以上、五线或末线治疗时使用；多个指定药物或多个治疗类别本身不进入T4。",
      "oncologyExamples": ["四线及以上", "五线治疗", "末线治疗"],
      "nonOncologyExamples": [],
      "keywords": ["四线", "4l", "五线", "5l", "六线", "6l", "末线治疗"],
      "regexPatterns": []
    },
    {
      "ruleId": "T3",
      "priority": 40,
      "label": "三线及后线/复发难治",
      "ratio": 0.3,
      "description": "三线及后线、多次复发、复发难治或经二线治疗后进展的患者。",
      "oncologyExamples": ["三线及以上", "后线治疗", "复发难治"],
      "nonOncologyExamples": ["难治性疾病", "多次复发"],
      "keywords": ["三线", "3l", "后线", "复发难治", "复发/难治", "复发或难治", "难治性", "多次复发"],
      "regexPatterns": [
        "经(?:过)?二线.{0,16}(?:失败|进展|不耐受)",
        "二线.{0,12}(?:治疗)?后.{0,12}(?:失败|进展|复发|不耐受)"
      ]
    },
    {
      "ruleId": "T2",
      "priority": 30,
      "label": "二线/一线治疗失败",
      "ratio": 0.5,
      "description": "二线、既往接受指定药物/多个治疗类别、经一线或常规治疗失败的患者。",
      "oncologyExamples": ["二线治疗", "经PD-1和化疗治疗失败", "接受指定药物治疗"],
      "nonOncologyExamples": ["多种生物制剂治疗失败", "常规治疗控制不佳"],
      "keywords": ["二线", "2l", "经一线", "一线后", "一线治疗失败", "一线标准治疗失败", "传统治疗失败", "常规治疗失败", "控制不佳", "维持治疗", "既往治疗", "接受过"],
      "regexPatterns": [
        "一线.{0,16}(?:失败|进展|复发|不耐受)",
        "(?:标准|常规|传统).{0,12}治疗.{0,12}(?:失败|控制不佳|不耐受)",
        "(?<!未)(?:经|既往|接受过?).{0,24}(?:药物|治疗|疗法)",
        "(?:多种|多类|两种及以上|多药).{0,16}(?:治疗|疗法|药物).{0,10}(?:失败|进展|不耐受)?",
        "(?:经|既往).{0,16}(?:及|和|联合|、|/).{0,16}(?:治疗)?(?:失败|进展|不耐受)"
      ]
    },
    {
      "ruleId": "T1",
      "priority": 20,
      "label": "初始治疗/一线治疗",
      "ratio": 0.7,
      "description": "初治、一线或围手术期患者；非肿瘤中重度/活动性口径另行联网检索，不使用本固定比例。",
      "oncologyExamples": ["一线治疗", "初治", "围手术期", "新辅助治疗"],
      "nonOncologyExamples": [],
      "keywords": ["一线", "1l", "初治", "围手术", "新辅助", "辅助治疗", "晚期", "不可切除"],
      "regexPatterns": []
    },
    {
      "ruleId": "T0",
      "priority": 0,
      "label": "无明确治疗状态限制",
      "ratio": 1.0,
      "description": "适应症未出现明确线次、既往治疗失败或高度筛选条件。",
      "oncologyExamples": ["全部符合适应症患者"],
      "nonOncologyExamples": ["全部确诊患者"],
      "keywords": [],
      "regexPatterns": []
    }
  ]
}
